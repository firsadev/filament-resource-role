{
    "name": "firsadev/filament-resource-role",
    "description": "This is my package filament-resource-role",
    "keywords": [
        "firsadev",
        "laravel",
        "filamentphp",
        "filament-resource-role"
    ],
    "homepage": "https://github.com/firsadev/filament-resource-role",
    "support": {
        "issues": "https://github.com/firsadev/filament-resource-role/issues",
        "source": "https://github.com/firsadev/filament-resource-role"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "firsadev28",
            "email": "firsadev28@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^4.0",
        "spatie/laravel-package-tools": "^1.15.0"
    },
    "require-dev": {
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^9.0|^10.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-arch": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0",
        "pestphp/pest-plugin-livewire": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Firsadev\\FilamentResourceRole\\": "src/",
            "Firsadev\\FilamentResourceRole\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Firsadev\\FilamentResourceRole\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "lint": "pint",
        "test": "pest",
        "test:lint": "pint --test"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Firsadev\\FilamentResourceRole\\FilamentResourceRoleServiceProvider"
            ],
            "aliases": {
                "FilamentResourceRole": "Firsadev\\FilamentResourceRole\\Facades\\FilamentResourceRole"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}